{
    "name": "hotel-example-codeceptjs-ja",
    "version": "2023.9.6",
    "private": true,
    "description": "Example codes for learning test automation.",
    "packageManager": "pnpm@11.2.2",
    "scripts": {
        "test": "codeceptjs run",
